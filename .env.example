# Variables docker-compose.yml substitutes when it builds the stack.
# Copy to .env next to docker-compose.yml and fill in what you use.
# Everything here has a working default except where noted, so an empty file
# still starts. Secrets belong in .env, never in docker-compose.yml itself.
#
# The application's own settings (models, clip lengths, API keys it reads at
# runtime) live in backend/.env - see backend/.env.example for those.

# ---- Ports ----------------------------------------------------------------
# Host port the API and UI are published on. Inside the network the app is
# always http://shorts-api:5001, which is what the n8n workflows use; this only
# moves the door on your machine (two stacks on one host, for example).
SHORTS_API_HOST_PORT=5002

# ---- Workers --------------------------------------------------------------
# Jobs one worker runs at a time.
WORKER_MAX_JOBS=2
# FFmpeg encoder threads per render. 0 means "use every core", which is right
# for a single worker and wrong for several: with 8 cores and 2 workers at 2
# jobs each, set 2 so the renders split the machine.
WORKER_FFMPEG_THREADS=0

# ---- Voiceover (off by default) -------------------------------------------
TTS_ENABLED=false
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=CwhRBWXzGAHq8TQ4Fs17

# ---- n8n ------------------------------------------------------------------
# HTTP basic auth in front of n8n's webhook endpoints. Off unless you set both
# a user and a password; the editor login is a separate account created in the
# n8n UI on first run, and this does not protect it.
N8N_BASIC_AUTH_ACTIVE=false
N8N_BASIC_AUTH_USER=
N8N_BASIC_AUTH_PASSWORD=

# ---- TikTok Content Posting API -------------------------------------------
# A browser sessionid cookie cannot publish; these two are the app credentials
# from TikTok for Developers (app with the Content Posting API product and the
# user.info.basic + video.publish scopes). Leave blank to keep TikTok inert, or
# put them in storage/secrets/tiktok_client.json instead of this file.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Must be listed as an allowed redirect URI on the TikTok app.
TIKTOK_REDIRECT_URI=http://localhost:5001/api/tiktok/oauth2callback
# DRAFT saves each publish to the account's drafts (the safe default for a
# freshly connected app); DIRECT_PUBLISH posts it; UPLOAD leaves it in the inbox.
TIKTOK_POST_MODE=DRAFT
