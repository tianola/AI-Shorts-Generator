# AI Shorts Generator - example environment variables
# Copy to .env and fill sensitive values. Do NOT commit real secrets.

# LLM provider
AI_PROVIDER=omniroute
OMNIROUTE_BASE_URL=http://localhost:20128/v1
OMNIROUTE_API_KEY=your_omniroute_key_here
OMNIROUTE_MODEL=auto/best-coding

# Fast transcription provider
TRANSCRIPTION_PROVIDER=groq
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_API_KEY=your_groq_key_here
GROQ_MODEL=whisper-large-v3-turbo

# Optional fallback to local Ollama
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5-coder:14b
METADATA_OLLAMA_MODEL=qwen2.5-coder:14b

# Whisper model size (faster-whisper)
WHISPER_MODEL_SIZE=tiny

# Storage paths
STORAGE_ROOT=/app/storage

# Worker / clips
NUM_CLIPS=10
MIN_CLIP_SECONDS=20
MAX_CLIP_SECONDS=75

# ElevenLabs TTS (disabled by default)
# Enable only when you want to generate spoken narration for each clip.
TTS_ENABLED=false
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=CwhRBWXzGAHq8TQ4Fs17

# FFmpeg tuning
FFMPEG_PRESET=veryfast
FFMPEG_CRF=20
