# AI Shorts Generator - example environment variables
# Copy to .env and fill sensitive values. Do NOT commit real secrets.

# LLM provider
AI_PROVIDER=omniroute
OMNIROUTE_BASE_URL=http://localhost:20128/v1
OMNIROUTE_API_KEY=your_omniroute_key_here
OMNIROUTE_MODEL=free/shorts
# Legs tried in order when the head times out twice or answers with no JSON.
# Any of them may be a free upstream that goes dead; the log names the one
# that produced the clips.
OMNIROUTE_MODEL_FALLBACKS=free/best

# Fast transcription provider
TRANSCRIPTION_PROVIDER=groq
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_API_KEY=your_groq_key_here
GROQ_MODEL=whisper-large-v3-turbo

# Optional fallback to local Ollama
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5-coder:14b
METADATA_OLLAMA_MODEL=qwen2.5-coder:14b

# Local vision model for scene attention (names buildings/construction/cities
# that YOLO's COCO classes miss). Needs Ollama running with the model pulled:
# see setup_local_vlm.ps1. Prefer it over the remote tiers when true.
LOCAL_VLM_ENABLED=false
LOCAL_VLM_URL=http://localhost:11434
LOCAL_VLM_MODEL=moondream

# Whisper model size (faster-whisper)
WHISPER_MODEL_SIZE=small

# Speaker diarization (pyannote). Tells the reframe decision WHO is talking
# instead of guessing from head motion, so a clip with two visible people can be
# stacked or followed by voice. The pyannote checkpoints are gated on
# Hugging Face: accept the model conditions on its page and put the token here.
# Without a token the stage logs one line and the pipeline behaves as before.
HF_KEY=
DIARIZATION_ENABLED=true
DIARIZATION_MODEL=pyannote/speaker-diarization-3.1

# Scene/object attention. Decides WHAT the crop centres on while the narration is
# describing something on screen (a laptop, a product, a pet). Tier 1 is a local
# word-to-detection match and always runs; tier 2 asks the text model above once
# per clip and is skipped if it is unreachable; tier 3 looks at frames and is off
# until you name a vision model.
SCENE_ATTENTION_ENABLED=true
SCENE_ATTENTION_VLM=false
# Any image-capable model on the gateway, e.g. moondream3.1 or MiniCPM-V-4.5.
SCENE_ATTENTION_VLM_MODEL=

# Which COCO classes count as worth focusing on (comma-separated names). Leave
# unset for the built-in list; 'person' is always kept because the tracking that
# every layout decision reads depends on it.
# YOLO_FOCUS_CLASSES=laptop,cell phone,tv,dog

# Model weights for the vertical reframe's object detection (CPU).
YOLO_MODEL=yolov8n.pt

# Storage paths
STORAGE_ROOT=/app/storage

# Disk guardrails. A multi-hour source video is tens of gigabytes (one job
# downloaded 17 GB), and a download that fills the volume also corrupts the
# SQLite database sitting on it. The worker leaves jobs queued while the drive
# is below this margin, and aborts a download that runs out mid-flight.
MIN_FREE_DISK_GB=10
# audio.wav is only an input to the transcriber - words.json and segments.json
# carry the result onwards, so the wav is removed once the transcript is there.
DELETE_AUDIO_AFTER_TRANSCRIPTION=true

# Worker / clips
NUM_CLIPS=10
MIN_CLIP_SECONDS=30
MAX_CLIP_SECONDS=60

# A job created without an explicit auto_upload flag publishes its rendered clips.
# Set it to false to keep every new job local until a request asks for auto_upload=true.
DEFAULT_AUTO_UPLOAD=true
# Visibility of those automatic uploads: public | unlisted | private.
AUTO_UPLOAD_PRIVACY=unlisted

# Publish queue. A rendered clip from a job with auto_upload on is not uploaded the
# moment it finishes: it waits in the database (clips.publish_due_at) and the worker
# releases one publish per gap. The clock is the last published_at row rather than
# process memory, so a worker restart cannot make the next upload immediate - that
# was the hole in the old pacing, which kept its stamp in a dict.
UPLOAD_MIN_GAP_SECONDS=3600
UPLOAD_GAP_JITTER_SECONDS=600
# A failed upload stays queued. Ordinary faults (dead token, network, missing file)
# retry after this and count against MAX_UPLOAD_RETRIES, after which the clip leaves
# the queue for a human. YouTube's uploadLimitExceeded is the channel's budget and
# not the clip's fault, so it waits PUBLISH_LIMIT_RETRY_HOURS without burning an
# attempt.
PUBLISH_RETRY_MINUTES=30
PUBLISH_LIMIT_RETRY_HOURS=6

# Worker concurrency. Jobs are claimed with a compare-and-swap on status, so any
# number of worker processes can poll the same database: exactly one of them wins
# each job, the rest move on to the next queued row. A worker that dies leaves the
# row in 'processing', and the lease below is what puts it back in the queue.
# Keep WORKER_MAX_JOBS low until FFMPEG_THREADS is capped: a render is ffmpeg-bound
# and an uncapped encode already uses every core, so concurrent renders mostly
# slow each other down.
WORKER_MAX_JOBS=2
JOB_LEASE_MINUTES=90
# Watchdog: a job with no progress signal for WORKER_STALL_TIMEOUT_MINUTES is only
# declared wedged if the process ALSO burned under WORKER_STALL_MIN_CPU_SECONDS of
# CPU over that window. A genuine wedge (blocked main thread) does neither; a slow
# compute stage (diarization on a long source, YOLO temporal localization) has no
# tick but keeps burning CPU, so it is spared. The job is failed and the worker
# exits so the NSSM service restarts a clean one.
WORKER_STALL_TIMEOUT_MINUTES=30
WORKER_STALL_MIN_CPU_SECONDS=120

# ElevenLabs TTS (disabled by default)
# Enable only when you want to generate spoken narration for each clip.
TTS_ENABLED=false
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=CwhRBWXzGAHq8TQ4Fs17

# FFmpeg tuning (ffmpeg and ffprobe must be on PATH; the API and worker log
# the resolved versions at startup and say so loudly when they are missing)
FFMPEG_PRESET=veryfast
FFMPEG_CRF=20
# 0 = let x264 use every logical core. Lower it only if encode RAM is tight;
# the cap costs roughly 2x wall time on a 16-thread desktop.
FFMPEG_THREADS=0

# YouTube download: yt-dlp solves the unsigned-"n" challenge with the EJS remote
# component, which needs a JS runtime. yt-dlp only enables deno by default; leave
# this empty to auto-detect node (PATH, then C:\Program Files\nodejs\node.exe),
# or set an absolute path (needed when the worker runs as a service whose PATH has
# no node dir). Without a runtime the web client fails "The page needs to be reloaded".
YT_REMOTE_COMPONENTS=ejs:github
YT_NODE_PATH=

# Optional: Claude for story analysis, clip selection and judging. Without a key
# everything runs on the OmniRoute chain above.
ANTHROPIC_API_KEY=
CLAUDE_SELECTION_MODEL=claude-opus-5-5
# Keyframes per candidate the Claude judge looks at (0 = words only)
JUDGE_FRAMES_PER_CLIP=4
# Most/least watched past clips (by synced YouTube views) shown to clip
# selection as examples of this audience. Works with either model; 0 = off.
CHANNEL_EXAMPLES=4
