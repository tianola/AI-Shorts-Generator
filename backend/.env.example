# AI Shorts Generator - example environment variables
# Copy to .env and fill sensitive values. Do NOT commit real secrets.

# LLM provider
AI_PROVIDER=omniroute
OMNIROUTE_BASE_URL=http://localhost:20128/v1
OMNIROUTE_API_KEY=your_omniroute_key_here
OMNIROUTE_MODEL=auto/best-coding

# Fast transcription provider
TRANSCRIPTION_PROVIDER=groq
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_API_KEY=your_groq_key_here
GROQ_MODEL=whisper-large-v3-turbo

# Optional fallback to local Ollama
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5-coder:14b
METADATA_OLLAMA_MODEL=qwen2.5-coder:14b

# Whisper model size (faster-whisper)
WHISPER_MODEL_SIZE=tiny

# Storage paths
STORAGE_ROOT=/app/storage

# Disk guardrails. A multi-hour source video is tens of gigabytes (one job
# downloaded 17 GB), and a download that fills the volume also corrupts the
# SQLite database sitting on it. The worker leaves jobs queued while the drive
# is below this margin, and aborts a download that runs out mid-flight.
MIN_FREE_DISK_GB=10
# audio.wav is only an input to the transcriber - words.json and segments.json
# carry the result onwards, so the wav is removed once the transcript is there.
DELETE_AUDIO_AFTER_TRANSCRIPTION=true

# Worker / clips
NUM_CLIPS=10
MIN_CLIP_SECONDS=20
MAX_CLIP_SECONDS=75

# Worker concurrency. Jobs are claimed with a compare-and-swap on status, so any
# number of worker processes can poll the same database: exactly one of them wins
# each job, the rest move on to the next queued row. A worker that dies leaves the
# row in 'processing', and the lease below is what puts it back in the queue.
# Keep WORKER_MAX_JOBS low until FFMPEG_THREADS is capped: a render is ffmpeg-bound
# and an uncapped encode already uses every core, so concurrent renders mostly
# slow each other down.
WORKER_MAX_JOBS=2
JOB_LEASE_MINUTES=90

# ElevenLabs TTS (disabled by default)
# Enable only when you want to generate spoken narration for each clip.
TTS_ENABLED=false
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=CwhRBWXzGAHq8TQ4Fs17

# FFmpeg tuning (ffmpeg and ffprobe must be on PATH; the API and worker log
# the resolved versions at startup and say so loudly when they are missing)
FFMPEG_PRESET=veryfast
FFMPEG_CRF=20
# 0 = let x264 use every logical core. Lower it only if encode RAM is tight;
# the cap costs roughly 2x wall time on a 16-thread desktop.
FFMPEG_THREADS=0
